# Load with: node --env-file=.env dist/index.js   (Node 22+; the server does not read .env on its own)

# nominatim (default, no key) | google | mapbox
GEOCODING_PROVIDER=nominatim
# Required for google and mapbox
# GEOCODING_API_KEY=

# Identify your deployment to public APIs (Nominatim usage policy requires a contact)
GEO_USER_AGENT=mcp-server-geo-optimizer/1.0.0 (contact: you@example.com)

# Public demo server: rate limited, no SLA. Use your own instance for real workloads.
OSRM_URL=https://router.project-osrm.org
# Max coordinates per OSRM table request (demo server limit is 100; raise for self-hosted OSRM)
OSRM_MAX_TABLE_SIZE=100

# Speed used to turn straight-line km into minutes when OSRM is not used
HAVERSINE_SPEED_KMH=40

# Minimum spacing between requests to nominatim.openstreetmap.org and router.project-osrm.org (>= 1000)
PUBLIC_API_MIN_INTERVAL_MS=1000

HTTP_TIMEOUT_MS=10000
# Retries for 5xx, 429, and network errors (0-5)
HTTP_RETRIES=2
CACHE_TTL_SECONDS=300

# debug | info | warn | error
LOG_LEVEL=info
# development | production | test
NODE_ENV=production
